# Private key of the wallet that will deploy and own the contract
PRIVATE_KEY=your_private_key_here

# BDAG token contract address (verify from blockdag.network)
BDAG_TOKEN=0x...

# DEX Router address (Uniswap V2-compatible)
# Uniswap V2 (ETH): 0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
# PancakeSwap (BSC): 0x10ED43C718714eb63d5aA57B78B54704E256024E
DEX_ROUTER=0x...

# RPC endpoints (optional, defaults provided)
BLOCKDAG_RPC=https://rpc.blockdag.network
BLOCKDAG_CHAIN_ID=0
ETH_RPC=https://eth.llamarpc.com
BSC_RPC=https://bsc-dataseed1.binance.org
